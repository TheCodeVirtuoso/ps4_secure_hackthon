# Force LF on all text files so shell scripts / Dockerfile / configs run on Linux
# even though the repo was authored on Windows.
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.md      text eol=lf
Dockerfile text eol=lf
.gitkeep  text eol=lf

# Binaries — never touch line endings
*.pdf  binary
*.png  binary
*.jpg  binary
*.pcap binary
